    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "db:seed:content": "tsx scripts/seed-content.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "sql:lint": "tsx scripts/sql-lint.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@neon/config": "^1.9.1",
    "@neon/env": "^1.6.1",
    "@vercel/functions": "^3.9.11",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "marked": "^18.1.1",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
